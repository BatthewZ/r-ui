{
  "name": "@batthewz/r-ui-react-components",
  "version": "0.1.2",
  "type": "module",
  "description": "React 19 component library for the r-ui design system. Pairs with @batthewz/r-ui-css.",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "scripts/verify-domain-contrast.mjs",
    "scripts/lib/color.mjs",
    "scripts/lib/css.mjs",
    "scripts/lib/domain-pairs.mjs",
    "scripts/lib/gate.mjs",
    "scripts/lib/themes.mjs",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "r-ui-domain-contrast": "./scripts/verify-domain-contrast.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./theme-script": {
      "types": "./dist/util/preferences.d.ts",
      "import": "./dist/util/preferences.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:no-css-imports": "node scripts/verify-no-css-imports.mjs",
    "verify:no-raw-tailwind": "node scripts/verify-no-raw-tailwind.mjs",
    "verify:utilities-exist": "node scripts/verify-utilities-exist.mjs",
    "verify:domain-pairs": "node scripts/verify-domain-pairs.mjs",
    "verify:series-palette": "node scripts/verify-series-palette.mjs",
    "verify:domain-contrast": "node scripts/verify-domain-contrast.mjs",
    "verify:showcase-themes": "node scripts/verify-showcase-themes.mjs",
    "verify:token-mirror": "node scripts/verify-token-mirror.mjs",
    "verify:class-prefix": "node scripts/verify-class-prefix.mjs",
    "verify:no-html-injection": "node scripts/verify-no-html-injection.mjs",
    "verify:group-deps": "node scripts/verify-group-deps.mjs",
    "verify:browser-tags": "node scripts/verify-browser-tags.mjs",
    "verify": "bun run verify:no-css-imports && bun run verify:no-raw-tailwind && bun run verify:utilities-exist && bun run verify:domain-pairs && bun run verify:series-palette && bun run verify:domain-contrast && bun run verify:showcase-themes && bun run verify:token-mirror && bun run verify:class-prefix && bun run verify:no-html-injection && bun run verify:group-deps && bun run verify:browser-tags",
    "check": "bun run verify && bun run typecheck && bun run lint && bun run test",
    "showcase:dev": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:preview": "vite preview --config showcase/vite.config.ts",
    "browser:check": "node scripts/browser-check.mjs"
  },
  "peerDependencies": {
    "@batthewz/r-ui-css": "^0.1.1",
    "@floating-ui/react": "^0.27.0",
    "lucide-react": ">=0.500.0 <2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@batthewz/r-ui-tw-merge": "workspace:^",
    "highlight.js": "~11.11.0",
    "lowlight": "^3.3.0"
  },
  "devDependencies": {
    "@batthewz/r-ui-css": "workspace:^",
    "@floating-ui/react": "0.27.20",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/michroma": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "glob": "13.0.6",
    "jsdom": "29.1.1",
    "lucide-react": "0.564.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.4",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.12"
  },
  "keywords": [
    "design-system",
    "react",
    "ui",
    "components",
    "tailwindcss-v4"
  ],
  "license": "MIT",
  "author": "BatthewZ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BatthewZ/r-ui.git",
    "directory": "r-ui-react-components"
  },
  "homepage": "https://github.com/BatthewZ/r-ui/tree/main/r-ui-react-components#readme",
  "bugs": {
    "url": "https://github.com/BatthewZ/r-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
