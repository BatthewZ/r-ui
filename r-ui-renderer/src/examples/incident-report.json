                          "language": "diff",
                          "highlightLines": [3],
                          "code": " LEDGER_REGION=eu-central-1\n LEDGER_POOL_MIN=10\n-LEDGER_POOL_MAX=200\n+LEDGER_POOL_MAX=20\n LEDGER_POOL_TIMEOUT_MS=30000"
                        }
                      }
