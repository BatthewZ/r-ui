{
  "name": "@batthewz/r-ui-renderer",
  "version": "0.1.0",
  "type": "module",
  "description": "Render JSON ViewSpec documents as @batthewz/r-ui-react-components, while they stream, and validate them anywhere without React.",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "VIEWSPEC.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "r-ui-validate": "./dist/cli/r-ui-validate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spec": {
      "types": "./dist/spec/index.d.ts",
      "import": "./dist/spec/index.js"
    },
    "./stream": {
      "types": "./dist/stream/index.d.ts",
      "import": "./dist/stream/index.js"
    },
    "./reference": {
      "types": "./dist/reference/index.d.ts",
      "import": "./dist/reference/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "import": "./dist/zod/index.js"
    },
    "./styles": {
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./schema.json": "./dist/schema.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:react-free": "node scripts/verify-react-free.mjs",
    "verify:no-suppressions": "node scripts/verify-no-suppressions.mjs",
    "verify:source-text": "node scripts/verify-source-text.mjs",
    "verify": "bun run verify:react-free && bun run verify:no-suppressions && bun run verify:source-text",
    "check": "bun run verify && bun run typecheck && bun run lint && bun run test"
  },
  "peerDependencies": {
    "@batthewz/r-ui-react-components": "^0.1.0",
    "lucide-react": ">=0.500.0 <2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@batthewz/r-ui-css": "workspace:^",
    "@batthewz/r-ui-react-components": "workspace:^",
    "@tailwindcss/node": "4.3.3",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "glob": "13.0.6",
    "jsdom": "29.1.1",
    "lucide-react": "0.564.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.10",
    "zod": "4.6.5"
  },
  "keywords": [
    "design-system",
    "react",
    "json",
    "renderer",
    "server-driven-ui",
    "llm",
    "streaming"
  ],
  "license": "MIT",
  "author": "BatthewZ"
}
